     "step3_modules":["Market and Industry","Audience","Competition","Channels and Sales"]},
    {"id":"G3","name":"Campaigns, Social and Content",
     "tasks":["Campaign concept / big idea","Festive / seasonal campaign","Social media strategy","Social media calendar","Podcast plan","Influencer strategy","Brand collaboration ideas","Innovation ideas"],
     "group_checkpoints":[{"id":"G3.1","name":"Platforms / channels","meaning":"","must":true,"ask_options":["Instagram","LinkedIn","Facebook","YouTube","X / Twitter","WhatsApp"],"multi_select":true},{"id":"G3.2","name":"Volume","meaning":"posts per week, episodes, number of influencers","must":false},{"id":"G3.3","name":"Budget","meaning":"influencer, collaborations and campaigns only","must":false}],
     "step3_modules":["Audience","Competition","Culture and Trends"]},
    {"id":"G4","name":"Media and Performance",
     "tasks":["Media plan","Performance marketing plan","ATL/BTL plan","Post-campaign report / review"],
     "group_checkpoints":[{"id":"G4.1","name":"Budget","meaning":"","must":true},{"id":"G4.2","name":"KPI target","meaning":"reach, leads, CPL, ROAS, etc.","must":false,"ask_options":["Reach","Leads","CPL","ROAS","Engagement","Conversions"]},{"id":"G4.3","name":"Mediums / channels to include or exclude","meaning":"","must":false}],
     "step3_modules":["Audience","Competition","Channels and Sales"]},
    {"id":"G5","name":"Scripts and Production",
     "tasks":["TVC script","Influencer script","Shoot plan"],
     "group_checkpoints":[{"id":"G5.1","name":"Duration / format / platform","meaning":"e.g. 30-sec TVC, 60-sec Reel","must":true},{"id":"G5.2","name":"Key message or product","meaning":"","must":false},{"id":"G5.3","name":"Number of variants; cast and location","meaning":"shoot plan","must":false}],
     "step3_modules":["Audience","Competition","Culture and Trends"]},
    {"id":"G6","name":"Experiential",
     "tasks":["On-ground activation plan","Event strategy and planning"],
     "group_checkpoints":[{"id":"G6.1","name":"Location / venue / cities","meaning":"","must":true},{"id":"G6.2","name":"Scale","meaning":"footfall, guests, number of days","must":false},{"id":"G6.3","name":"Budget","meaning":"","must":true}],
     "step3_modules":["Audience","Culture and Trends","Channels and Sales"]},
    {"id":"G7","name":"Pitches and Presentations",
     "tasks":["New brand pitch","New project pitch","Investor deck","Sales presentation","Corporate PPT"],
     "group_checkpoints":[{"id":"G7.1","name":"Who it is presented to","meaning":"prospect name, investor stage, client type","must":true},{"id":"G7.2","name":"The ask","meaning":"win the account, raise an amount, close the sale","must":false},{"id":"G7.3","name":"Material available and slide count","meaning":"","must":false}],
     "step3_modules":["Market and Industry","Audience","Competition","Brand"]}
  ],
