{
  "version": 1,
  "core_checkpoints": [
    {"id":"C1","name":"Task","meaning":"What are we making?","default_source":"prompt","if_missing":"ask","always_first":true},
    {"id":"C2","name":"Objective","meaning":"What should it achieve? (awareness, leads, sales, launch, funding, etc.)","default_source":"prompt_or_brief","if_missing":"ask","ask_options":["Awareness","Leads","Sales","Launch","Funding","Retention / loyalty","All"],"multi_select":true},
    {"id":"C3","name":"Focus","meaning":"Whole brand, or a specific product/project/offering?","default_source":"prompt_or_brief","if_missing":"ask","ask_options":["Whole brand","Specific product / project / offering"]},
    {"id":"C4","name":"Audience and market","meaning":"Who it is for, and where","default_source":"brand_brief","if_missing":"prefill"},
    {"id":"C5","name":"Timeline","meaning":"Period, launch date or deadline","default_source":"prompt_or_brief","if_missing":"ask","ask_options":["This month","Next 3 months","This quarter","Specific date"]},
    {"id":"C6","name":"Mandatories and references","meaning":"Must-includes, don'ts, compliance, examples they like","default_source":"prompt_or_brief_or_guardrails","if_missing":"offer","optional":true}
  ],
  "groups": [
    {"id":"G1","name":"Brand and Communication Strategy",
     "tasks":["Brand positioning","Brand repositioning","Brand identity development","Personal branding","Communication / messaging strategy","PR and reputation strategy","Crisis communication plan","Employer branding","Naming and tagline","Brand audit / health check"],
     "group_checkpoints":[{"id":"G1.1","name":"Scope","meaning":"new or refresh","must":false},{"id":"G1.2","name":"Current situation","meaning":"what's not working (repositioning, crisis, audit)","must":false},{"id":"G1.3","name":"Whose brand","meaning":"person and role (personal branding only)","must":false}],
     "step3_modules":["Market and Industry","Audience","Competition","Brand"]},
    {"id":"G2","name":"Launch and Growth",
     "tasks":["GTM strategy","Project launch","Project sustenance plan","Lead generation plan","CRM / retention / loyalty plan","Website / SEO strategy"],
