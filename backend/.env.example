# Auth — JWT signing
JWT_SECRET_KEY=change-this-to-a-long-random-string

# Google Sign-In (must match frontend's NEXT_PUBLIC_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=
# Not read by any current backend code — kept only if a server-side token-exchange flow is added later.
GOOGLE_CLIENT_SECRET=

# LLM providers — at least ONE of these three is required, or ai_service.py raises
# RuntimeError("No valid LLM API key set in environment ...")
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# LLM model overrides — optional, each has a hardcoded default if omitted
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_MODEL=gpt-4o
GROQ_MODEL=openai/gpt-oss-120b

# Web research / competitor discovery — required, raises RuntimeError if missing
# (used by tavily_service.py: competitor search, brand scrape, deep dive)
TAVILY_API_KEY=

# Max seconds ai_service.stream_chat waits for a brand's research pipeline to
# finish before giving up and returning an honest "still processing" message
# instead of generating a report (never fabricates from general knowledge).
# Default (900s) is sized from the pipeline's real call count: ~17 Tavily
# calls for the brand + ~12 per competitor (up to 5) + 1 social-handle lookup
# per entity + the Instagram scraper's own up-to-300s run — comfortably covers
# a typical run with headroom for slower API responses.
REPORT_PIPELINE_WAIT_SECONDS=900

# Connector credential encryption — required, raises RuntimeError if missing/invalid
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTOR_ENCRYPTION_KEY=

# Console log verbosity (main.py). INFO (default) surfaces pipeline progress
# ([Pipeline] ...) and report-gating decisions ([REPORT_GATE] ...); WARNING
# would hide those and show only timeouts/failures.
LOG_LEVEL=INFO
