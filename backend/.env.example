# Auth — JWT signing
JWT_SECRET_KEY=change-this-to-a-long-random-string

# Google Sign-In (must match frontend's NEXT_PUBLIC_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=
# Not read by any current backend code — kept only if a server-side token-exchange flow is added later.
GOOGLE_CLIENT_SECRET=

# LLM providers — at least ONE of these four is required, or ai_service.py raises
# RuntimeError("No valid LLM API key set in environment ...")
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
QWEN_API_KEY=

# LLM model overrides — optional, each has a hardcoded default if omitted
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
OPENAI_MODEL=gpt-4o
MISTRAL_MODEL=open-mistral-7b
QWEN_MODEL=qwen-turbo

# Web research / competitor discovery — required, raises RuntimeError if missing
# (used by tavily_service.py: competitor search, brand scrape, deep dive)
TAVILY_API_KEY=

# Connector credential encryption — required, raises RuntimeError if missing/invalid
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTOR_ENCRYPTION_KEY=
